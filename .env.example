# Copy to .env (or .env.local) and fill in. Never commit real values.

# Public site URL (used for sitemap, canonical links and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used to invite/create admin users and by scripts/create-admin.ts
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase Postgres: Project Settings → Database → Connection string
# DIRECT_URL (session pooler) is used by `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# AWS S3 image uploads (admin → any image field → Upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
# Public base URL for uploaded files: a CloudFront/CDN URL or the bucket URL
NEXT_PUBLIC_S3_PUBLIC_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com
